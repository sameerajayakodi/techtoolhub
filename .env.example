# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# All of these are optional; the site works without any of them.

# Canonical URL of the site (https + www, no trailing slash). Optional: this is already the
# default in data/siteMetadata.js. Never set it to the *.vercel.app address.
NEXT_PUBLIC_SITE_URL=https://www.techtoolhub.online

# ── Google AdSense ──────────────────────────────────────────────
# Your publisher ID (AdSense → Account → Settings → Account information)
NEXT_PUBLIC_ADSENSE_CLIENT=
# Optional ad unit slot IDs (AdSense → Ads → By ad unit → Display ads)
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=

# ── Google Search Console & Analytics ───────────────────────────
# The content="..." value of the HTML-tag verification method (not needed if you verify the
# domain property via DNS). Rendered as <meta name="google-site-verification"> only when set.
GOOGLE_SITE_VERIFICATION=
# GA4 measurement ID (defaults to G-4KV56L6QE8 in data/siteMetadata.js; "off" disables it)
NEXT_PUBLIC_GA_ID=

# ── Contact form (free: https://web3forms.com) ──────────────────
NEXT_PUBLIC_WEB3FORMS_KEY=

# ── Comments (optional: https://giscus.app) ─────────────────────
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPOSITORY_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
