{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "techtoolhub-phi.vercel.app" }],
      "destination": "https://www.techtoolhub.online/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "techtoolhub-phi.vercel.app" }],
      "destination": "https://www.techtoolhub.online/:path*",
      "permanent": true
    }
  ]
}
